# Copy to .env for LOCAL development. Never commit .env.
# In the cloud these values come from your secret manager, not from a file in git.

APP_NAME=Library books
APP_OWNER=Anton Belov (0564)
APP_VERSION=dev

# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-to-at-least-32-random-characters

# MySQL (variant db_engine) — docker compose --profile mysql up
DB_PASSWORD=Change-Me-L0cal!Xx
DB_URL=mysql+pymysql://app_rw:$${DB_PASSWORD}@mysql:3306/campus
MYSQL_ROOT_PASSWORD=Change-Me-R00t!Xx

# Optional ClickHouse analytics (variant clickhouse_required=yes)
CLICKHOUSE_PASSWORD=Change-Me-CH!Xx
CLICKHOUSE_URL=clickhouse://analytics:Change-Me-CH!Xx@clickhouse:8123/campus

# Object storage: local | s3 | gcs
STORAGE_BACKEND=local
BUCKET=/app/data/uploads

LOG_LEVEL=INFO
LOG_FORMAT=json
# Variant password policy
PASSWORD_MIN_LENGTH=14

GRAFANA_ADMIN_PASSWORD=Change-Me-Graf4na!
